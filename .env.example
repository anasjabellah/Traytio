# Environment variables example for TUR SaaS platform
# Copy this file to .env (git‑ignored) and replace placeholders with real values.

# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=

# PostgreSQL connection string for Prisma (via Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct URL used by Prisma for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase (optional, for realtime features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional emails)
RESEND_API_KEY=
# Sender email address. Defaults to "onboarding@resend.dev" (Resend test sender).
# For production, verify a domain in Resend and set this to your verified sender.
# Example: RESEND_FROM_EMAIL=invitations@tur.ma
RESEND_FROM_EMAIL=

# App URL (used for invitation links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
