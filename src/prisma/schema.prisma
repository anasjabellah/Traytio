generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ==================== CORE MODELS ====================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  plan      String   @default("starter") // starter, professional, enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PDF branding
  primaryColor    String? @default("#C9A96E")
  secondaryColor  String? @default("#1a1a1a")
  pdfFontFamily   String? @default("DM Sans")

  // Company info (for PDF header/footer)
  companyName    String?
  companyAddress String?
  companyPhone   String?
  companyEmail   String?
  companyWebsite String?
  companyICE     String?
  companyIF      String?
  companyRC      String?

  // Document defaults
  invoicePrefix    String? @default("FAC")
  quotePrefix      String? @default("DEV")
  paymentDelayDays Int?    @default(30)
  invoiceFooter    String?
  invoiceTerms     String?
  invoiceNotes     String?

  // Relations
  users       UserOrganization[]
  clients     Client[]
  events      Event[]
  menus       Menu[]
  commandes   Commande[]
  invoices    Invoice[]
  payments    Payment[]
  stockItems  StockItem[]
  teamMembers TeamMember[]
  menuItems   MenuItem[]
  invitations Invitation[]

  @@map("organizations")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizations    UserOrganization[]
  createdCommandes Commande[]

  @@map("users")
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("user_organizations")
}

// ==================== CLIENT MODEL ====================

model Client {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?
  company        String?
  siret          String?
  notes          String?
  totalSpent     Decimal   @default(0)
  lastOrderAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commandes    Commande[]
  events       Event[]

  @@index([organizationId, name])
  @@index([organizationId, createdAt])
  @@index([organizationId, totalSpent])
  @@index([organizationId, lastOrderAt])
  @@map("clients")
}

// ==================== EVENT MODEL ====================

model Event {
  id             String      @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  type           EventType
  status         EventStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime?
  location       String?
  guestCount     Int?
  budget         Decimal?
  contactPerson  String?
  contactPhone   String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  commandes    Commande[]

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, createdAt])
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, status])
  @@map("events")
}

// ==================== MENU MODEL ====================

model Menu {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  category       MenuCategory
  pricePerPerson Decimal
  minPersons     Int          @default(1)
  maxPersons     Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commandeItems CommandeItem[]
  commandes     Commande[]
  menuItems     MenuMenuItem[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, isActive])
  @@map("menus")
}

// ==================== MENU-MENUITEM JUNCTION ====================

model MenuMenuItem {
  id         String @id @default(cuid())
  menuId     String
  menuItemId String
  defaultQty Int    @default(1)

  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuId, menuItemId])
  @@map("menu_menu_items")
}

// ==================== COMMANDE (ORDER) MODEL ====================

model Commande {
  id              String                @id @default(cuid())
  organizationId  String
  createdById     String?
  clientId        String
  eventId         String?
  number          String                // e.g., CMD-2024-001
  status          CommandeStatus        @default(DRAFT)
  eventType       EventType?
  eventDate       DateTime?
  guestCount      Int?
  location        String?
  menuId          String?
  menuName        String?
  pricePerPerson  Decimal?
  totalAmount     Decimal               @default(0)
  acomptePercent  Int                   @default(30)
  acompteAmount   Decimal               @default(0)
  paidAmount      Decimal               @default(0)
  remainingAmount Decimal               @default(0)
  paymentStatus   CommandePaymentStatus @default(UNPAID)
  notes           String?
  transportFees   Decimal?              @default(0)
  deliveryFees    Decimal?              @default(0)
  equipmentFees   Decimal?              @default(0)
  discountType    DiscountType?
  discountValue   Decimal?              @default(0)
  discountAmount  Decimal?              @default(0)
  taxRate         Decimal?              @default(0)
  taxLabel        String?
  taxAmount       Decimal?              @default(0)
  clientBudget    Decimal?
  contactName     String?
  contactPhone    String?
  internalNotes   String?
  clientNotes     String?
  pdfUrl          String?
  sentAt          DateTime?
  sentVia         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Relations
  createdBy    User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  event        Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  menu         Menu?                @relation(fields: [menuId], references: [id], onDelete: SetNull)
  items        CommandeItem[]
  invoices     Invoice[]
  tasks        CommandeTask[]
  attachments  CommandeAttachment[]
  activities   CommandeActivity[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([clientId])
  @@index([clientId, status])
  @@index([eventId])
  @@index([eventId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("commandes")
}

model CommandeNumberCounter {
  organizationId String
  year           Int
  lastNumber     Int      @default(0)

  @@id([organizationId, year])
  @@map("commande_number_counters")
}

model InvoiceNumberCounter {
  organizationId String
  year           Int
  type           String
  lastNumber     Int      @default(0)

  @@id([organizationId, year, type])
  @@map("invoice_number_counters")
}

model CommandeItem {
  id         String  @id @default(cuid())
  commandeId String
  menuId     String?
  name       String
  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal
  notes      String?
  menuItemId String?

  // Relations
  commande Commande  @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  menu     Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([commandeId])
  @@map("commande_items")
}

// ==================== COMMANDE TASK MODEL ====================

model CommandeTask {
  id         String    @id @default(cuid())
  commandeId String
  title      String
  isDone     Boolean   @default(false)
  dueDate    DateTime?
  createdAt  DateTime  @default(now())

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId])
  @@map("commande_tasks")
}

// ==================== COMMANDE ATTACHMENT MODEL ====================

model CommandeAttachment {
  id         String   @id @default(cuid())
  commandeId String
  name       String
  url        String
  type       String?
  createdAt  DateTime @default(now())

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId])
  @@map("commande_attachments")
}

// ==================== COMMANDE ACTIVITY MODEL ====================

model CommandeActivity {
  id          String   @id @default(cuid())
  commandeId  String
  userId      String?
  action      String
  description String
  createdAt   DateTime @default(now())

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId])
  @@map("commande_activities")
}

// ==================== INVOICE MODEL ====================

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  commandeId     String?
  number         String        // e.g., INV-2024-001
  type           InvoiceType   @default(DEVIS)
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  totalAmount    Decimal
  paidAmount     Decimal       @default(0)
  notes          String?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commande     Commande?    @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([commandeId])
  @@index([organizationId, dueDate])
  @@index([organizationId, createdAt])
  @@map("invoices")
}

// ==================== PAYMENT MODEL ====================

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  commandeId     String
  invoiceId      String?
  amount         Decimal
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commande     Commande     @relation(fields: [commandeId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([commandeId])
  @@index([invoiceId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("payments")
}

// ==================== STOCK MODEL ====================

model StockItem {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  category       StockCategory
  quantity       Int           @default(0)
  unit           String // kg, L, pcs, etc.
  minQuantity    Int           @default(0)
  unitPrice      Decimal?
  supplier       String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("stock_items")
}

enum MenuItemCategory {
  FOOD
  DRINKS
  DESSERTS
  DECORATION
  STAFF
  ENTERTAINMENT
  EXTRAS
}

model MenuItem {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  category       MenuItemCategory
  unitPrice      Decimal
  unit           String?
  isActive       Boolean          @default(true)
  notes          String?
  imageUrl       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menus         MenuMenuItem[]
  commandeItems CommandeItem[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("menu_items")
}

// ==================== INVITATION MODEL ====================

model Invitation {
  id             String   @id @default(cuid())
  email          String
  role           OrgRole  @default(MEMBER)
  token          String   @unique
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([organizationId, createdAt])
  @@map("invitations")
}

// ==================== TEAM MEMBER MODEL (deprecated) ====================

model TeamMember {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  role           String
  email          String?
  phone          String?
  avatar         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("team_members")
}

// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  MEMBER
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  SUPERADMIN
}

enum EventType {
  WEDDING
  CORPORATE
  BIRTHDAY
  ANNIVERSARY
  HOLIDAY
  OTHER
}

enum EventStatus {
  DRAFT
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MenuCategory {
  WEDDING
  CORPORATE
  BUFFET
  COCKTAIL
  BRUNCH
  DESSERT
  CUSTOM
}

enum CommandeStatus {
  DRAFT
  QUOTED
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum InvoiceType {
  DEVIS
  FACTURE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CommandePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  DEPOSIT_PAID
  PAID
  REFUNDED
}

enum StockCategory {
  INGREDIENT
  BEVERAGE
  DESSERT
  EQUIPMENT
  DECORATION
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

